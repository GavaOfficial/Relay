# Copia in /etc/relay/relay.env (permessi 600) e adatta.

# --- server Rust ---
RELAY_BIND=127.0.0.1:8080
RELAY_DATA=/var/lib/relay

GAVAAUTH_ISSUER=https://auth.gavatech.org
GAVAAUTH_AUDIENCE=gavaauth-clients
# openssl rand -base64 48
RELAY_SESSION_SECRET=CAMBIAMI-almeno-32-caratteri-casuali
RELAY_SESSION_TTL_HOURS=24

# NON impostare in produzione:
# RELAY_DEV_TOKENS=tok1=alice,tok2=bob

# --- sito Next.js ---
GAVAAUTH_URL=https://auth.gavatech.org
GAVAAUTH_CLIENT_ID=relay
SITE_URL=https://relay.tuodominio.it
API_ORIGIN=http://127.0.0.1:8080
# DEV_LOGIN=1
